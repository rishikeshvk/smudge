{
  "expo": {
    "name": "Kindred",
    "slug": "kindred",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kindred",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121716",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.kindred.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F3EF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 104,
          "dark": {
            "backgroundColor": "#121716",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "defaultChannel": "rituals",
          "icon": "./assets/images/notification-icon.png",
          "color": "#F0B24F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dcd3eb19-09f4-4d8c-99bc-c337baba369d"
      }
    },
    "owner": "rishikeshvk",
    "updates": {
      "url": "https://u.expo.dev/dcd3eb19-09f4-4d8c-99bc-c337baba369d"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
