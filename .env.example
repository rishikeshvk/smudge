POSTGRES_USER=kindred
POSTGRES_PASSWORD=kindred
POSTGRES_DB=kindred

LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL_CLASSIFIER=deepseek-v4.1-flash
LLM_MODEL_DRAFTER=glm-5.3
LLM_MODEL_AUDITOR=kimi-k3
LLM_MODEL_JUDGE=deepseek-v4-pro

DATABASE_URL=postgresql+psycopg://kindred:kindred@localhost:5432/kindred

EMBED_BASE_URL=http://localhost:11434/v1
# Ollama ignores the key, but the OpenAI client requires one.
EMBED_API_KEY=ollama
EMBED_MODEL=qwen3-embedding:0.6b

# Dev builds only: Kindred's clock can be moved from the app's Developer screen.
DEV_MODE=true
